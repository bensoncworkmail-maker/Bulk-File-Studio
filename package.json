{
  "name": "bulk-rename-studio",
  "version": "1.125.0",
  "description": "\u96e2\u7dda\u6536\u85cf\u3001\u6a19\u7c64\u3001\u81ea\u8a02\u8cc7\u6599\u5de5\u4f5c\u5340\u3001\u6279\u6b21\u91cd\u65b0\u547d\u540d\u8207\u6a94\u6848\u642c\u79fb\u5de5\u5177",
  "main": "src/main.js",
  "author": "Bulk File Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "changelog": "node build/update-changelog.js",
    "guide": "node build/generate-user-guide.js",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "dist:setup": "electron-builder --win nsis --publish never",
    "check:deps": "node build/check-dependencies.js",
    "prestart": "node build/check-dependencies.js",
    "predist:win": "node build/check-dependencies.js",
    "predist:portable": "node build/check-dependencies.js",
    "predist:setup": "node build/check-dependencies.js",
    "check:app": "node build/check-app-contracts.js",
    "audit:functions": "node build/check-app-contracts.js --write",
    "guide:workflows": "node build/generate-workflow-guide.js"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.bulkrenamestudio.desktop",
    "productName": "Bulk File Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "artifactName": "BulkFileStudio-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "BulkFileStudio-Portable-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "src/rename-job*.js",
      "src/rename-core.js",
      "src/rename-history.js",
      "src/offline-policy.js",
      "src/relocation-*.js",
      "src/move-core.js",
      "src/file-analysis*.js",
      "src/analysis-job.js",
      "src/document-preview.js",
      "src/bounded-file-read.js",
      "src/intranet-path.js",
      "src/notes-location-links.js"
    ]
  },
  "dependencies": {
    "jszip": "3.10.1",
    "xml-js": "1.6.11"
  }
}
