{
  "name": "bulk-rename-studio",
  "version": "1.5.0",
  "description": "離線收藏、標籤、批次重新命名與檔案搬移工具",
  "main": "src/main.js",
  "author": "Bulk File Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist:win": "electron-builder --win nsis portable",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.bulkrenamestudio.desktop",
    "productName": "Bulk File Studio",
    "directories": {"output": "dist"},
    "files": ["src/**/*", "package.json", "README.md", "LICENSE"],
    "asar": true,
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "BulkFileStudio-${version}-${arch}.${ext}"
    },
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "include":"build/installer.nsh"}
  }
}
